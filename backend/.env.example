# Application
PORT=8080

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Cookies
COOKIE_DOMAINS="localhost"
SECURE_COOKIE=false

# Database
MONGO_URI=
DB_NAME=much_todo_db

# Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_EXPIRATION_HOURS=72

# Redis
ENABLE_CACHE=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Testing
INTEGRATION=false

# Local MongoDB Docker Compose settings
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-local-password
MONGO_INITDB_ROOT_USERNAME=replace-with-a-local-username
MONGO_INITDB_DATABASE=much_todo_db
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# Optional Redis UI settings
REDIS_HOST=localhost
REDIS_PORT=6379
ME_CONFIG_BASICAUTH_USERNAME=replace-with-username
ME_CONFIG_BASICAUTH_PASSWORD=replace-with-password
